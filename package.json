{
  "name": "english-reader-for-anki",
  "private": true,
  "version": "0.2.1",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "npm run test:unit && npm run test:services",
    "typecheck": "tsc --noEmit",
    "test:e2e": "playwright test",
    "test:contracts": "node --test tests/contracts.test.ts",
    "test:unit": "vitest run",
    "test:services": "node scripts/test-services.mjs"
  },
  "dependencies": {
    "dompurify": "3.4.17",
    "epubjs": "0.3.93",
    "fflate": "0.8.3",
    "pdfjs-dist": "6.4.299",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@types/chrome": "0.1.24",
    "@types/jsdom": "30.0.0",
    "@types/node": "24.10.0",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "fake-indexeddb": "6.2.6",
    "jsdom": "27.0.1",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  },
  "overrides": {
    "@xmldom/xmldom": "0.9.12"
  }
}
